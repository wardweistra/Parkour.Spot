rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spots collection - all spots are public, authenticated users can create, admins/moderators can edit, only admins can delete any spot
    match /spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Users collection - users can only manage their own profile, admins can read/update all
    // Public profiles (isPublicProfile == true) are readable by anyone
    match /users/{userId} {
      // Allow read if:
      // 1. User is reading their own profile, OR
      // 2. User is an admin, OR
      // 3. Profile is public (isPublicProfile == true, defaulting to true if field doesn't exist)
      allow read: if request.auth != null && 
        (request.auth.uid == userId ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)) ||
        (resource.data.isPublicProfile == true || !('isPublicProfile' in resource.data));
      // Allow create only for self and forbid setting privileged flags
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isModerator == false;
      // Allow update for self but prevent privilege escalation on admin/moderator flags
      // Admins can update moderator status for any user
      allow update: if request.auth != null && 
        ((request.auth.uid == userId &&
          // Handle missing fields by defaulting to false
          // If field not in request.resource, it's unchanged, so use resource value (or false if missing)
          ('isAdmin' in request.resource.data ? request.resource.data.isAdmin : ('isAdmin' in resource.data ? resource.data.isAdmin : false)) == 
          ('isAdmin' in resource.data ? resource.data.isAdmin : false) &&
          ('isModerator' in request.resource.data ? request.resource.data.isModerator : ('isModerator' in resource.data ? resource.data.isModerator : false)) == 
          ('isModerator' in resource.data ? resource.data.isModerator : false)) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
          // Admins can only update isModerator flag, not isAdmin
          // Handle case where isAdmin field might not exist in old documents
          // If isAdmin not in request.resource, it's unchanged, so use resource value (or false if missing)
          ('isAdmin' in request.resource.data ? request.resource.data.isAdmin : ('isAdmin' in resource.data ? resource.data.isAdmin : false)) == 
          ('isAdmin' in resource.data ? resource.data.isAdmin : false)));
    }
    
    // Ratings collection - users can read all ratings, authenticated users can create their own
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Spot reports - anyone can submit, only moderators/admins can view or manage
    match /spotReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
    }

    // Comments collection - users can read all comments, authenticated users can create, owners can edit/delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // SyncSources collection - all sync sources are public
    match /syncSources/{sourceId} {
      allow read: if true; // Allow all users to read sync sources
      // Only allow admin users to write (this would be handled by Firebase Functions with admin privileges)
    }
    
    // AuditLog collection - logs moderator actions on spots
    match /auditLog/{logId} {
      // Only moderators and admins can read audit logs
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      // Only moderators and admins can create audit log entries (when performing actions)
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true) &&
        // Ensure the userId in the log matches the authenticated user
        request.resource.data.userId == request.auth.uid;
      // No updates or deletes allowed (immutable audit log)
      allow update, delete: if false;
    }

    // SpotLists collection - all lists are publicly readable, users can only manage their own lists
    match /spotLists/{listId} {
      // All lists are publicly readable
      allow read: if true;
      // Users can create lists (service validates feature access)
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid;
      // Users can update their own lists
      allow update: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
      // Users can delete their own lists
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // DuplicateDetectionResults collection - moderators and admins can read
    match /duplicateDetectionResults/{runId} {
      // Moderators and admins can read duplicate detection results
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      // Only Cloud Functions (with admin privileges) can create/delete
      allow create, delete: if false;
      // Moderators and admins can update the collapsedPairs field for UI preferences
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true) &&
        // Ensure collapsedPairs is a list if present
        (!('collapsedPairs' in request.resource.data) || request.resource.data.collapsedPairs is list);
    }

    // UserActivityMetrics collection - only admins can read, only Cloud Functions can write
    match /userActivityMetrics/{dateId} {
      // Only admins can read activity metrics
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      // Only Cloud Functions (with admin privileges) can create/update/delete
      allow create, update, delete: if false;
    }

    // ApiClients collection - only Cloud Functions (admin SDK) read/write
    // Flutter admin UI uses callables (getApiClients, etc.) which run as admin
    match /apiClients/{clientId} {
      allow read, write: if false;
      match /usage/{dateId} {
        allow read, write: if false;
      }
    }
  }
}
