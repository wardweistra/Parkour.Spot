rules_version = '2';
service cloud.firestore {
  // Must use database id `(default)` here: `{database}` is only in scope inside
  // `match /databases/{database}/documents`, not in top-level functions (CLI warns
  // "Invalid variable name: database" and admin checks can fail).
  // Align with Cloud Functions `ensureAdmin`: custom claim `admin` OR Firestore flag.
  function requestingUserIsAdmin() {
    return request.auth != null && (
      request.auth.token.admin == true ||
      (
        exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
      )
    );
  }

  match /databases/{database}/documents {
    // Spots collection - all spots are public, authenticated users can create, admins/moderators can edit, only admins can delete any spot
    match /spots/{spotId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      allow delete: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Spot check-ins (one document per check-in event; query by userId and/or spotId)
    match /spotCheckIns/{checkInId} {
      function spotCheckInCommentOk(data) {
        return !('comment' in data) ||
          (data.comment is string && data.comment.size() <= 200);
      }
      function spotCheckInConvertedFromPlanOk(data) {
        return !('convertedFromTrainingPlanId' in data) ||
          (data.convertedFromTrainingPlanId is string &&
            data.convertedFromTrainingPlanId.size() > 0 &&
            data.convertedFromTrainingPlanId.size() <= 128);
      }
      function spotCheckInConvertedPlanSnapshotOk(data) {
        return !('convertedFromTrainingPlanId' in data) || (
          data.convertedPlanPlannedStartAt is timestamp
          && data.convertedPlanPlannedEndAt is timestamp
          && (!('convertedPlanComment' in data) ||
            (data.convertedPlanComment is string &&
              data.convertedPlanComment.size() <= 200))
          && (!('convertedPlanCreatedAt' in data) ||
            (data.convertedPlanCreatedAt is timestamp))
        );
      }
      function spotCheckInCreateShape() {
        return request.resource.data.userId == request.auth.uid
          && request.resource.data.spotId is string
          && request.resource.data.spotId.size() > 0
          && request.resource.data.isPrivate is bool
          && request.resource.data.checkedInAt == request.time
          && request.resource.data.expectedEndAt is timestamp
          && request.resource.data.expectedEndAt >= request.time
          && request.resource.data.expectedEndAt
            <= request.time + duration.value(12, 'h')
          && spotCheckInCommentOk(request.resource.data)
          && spotCheckInConvertedFromPlanOk(request.resource.data)
          && spotCheckInConvertedPlanSnapshotOk(request.resource.data)
          && (!('spotName' in request.resource.data) ||
            (request.resource.data.spotName is string &&
              request.resource.data.spotName.size() <= 500));
      }
      function spotCheckInUpdateShape() {
        return request.auth != null
          && request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.spotId == resource.data.spotId
          && request.resource.data.checkedInAt is timestamp
          && request.resource.data.expectedEndAt is timestamp
          && request.resource.data.checkedInAt <= request.time
          && request.resource.data.expectedEndAt
            > request.resource.data.checkedInAt
          && request.resource.data.expectedEndAt
            <= request.resource.data.checkedInAt + duration.value(12, 'h')
          && ((!('displayName' in resource.data)
                && !('displayName' in request.resource.data))
              || request.resource.data.displayName == resource.data.displayName)
          && ((!('photoURL' in resource.data)
                && !('photoURL' in request.resource.data))
              || request.resource.data.photoURL == resource.data.photoURL)
          && ((!('spotName' in resource.data)
                && !('spotName' in request.resource.data))
              || request.resource.data.spotName == resource.data.spotName)
          && ((!('convertedFromTrainingPlanId' in resource.data)
                && !('convertedFromTrainingPlanId' in request.resource.data))
              || request.resource.data.convertedFromTrainingPlanId
                == resource.data.convertedFromTrainingPlanId)
          && ((!('convertedPlanPlannedStartAt' in resource.data)
                && !('convertedPlanPlannedStartAt' in request.resource.data))
              || request.resource.data.convertedPlanPlannedStartAt
                == resource.data.convertedPlanPlannedStartAt)
          && ((!('convertedPlanPlannedEndAt' in resource.data)
                && !('convertedPlanPlannedEndAt' in request.resource.data))
              || request.resource.data.convertedPlanPlannedEndAt
                == resource.data.convertedPlanPlannedEndAt)
          && ((!('convertedPlanComment' in resource.data)
                && !('convertedPlanComment' in request.resource.data))
              || request.resource.data.convertedPlanComment
                == resource.data.convertedPlanComment)
          && ((!('convertedPlanCreatedAt' in resource.data)
                && !('convertedPlanCreatedAt' in request.resource.data))
              || request.resource.data.convertedPlanCreatedAt
                == resource.data.convertedPlanCreatedAt)
          && request.resource.data.isPrivate is bool
          && spotCheckInCommentOk(request.resource.data)
          && spotCheckInConvertedFromPlanOk(request.resource.data)
          && spotCheckInConvertedPlanSnapshotOk(request.resource.data);
      }
      allow read: if resource.data.isPrivate == false
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && spotCheckInCreateShape();
      allow update: if request.auth != null && spotCheckInUpdateShape();
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Planned training windows at a spot (separate from live check-ins).
    match /spotTrainingPlans/{planId} {
      function spotTrainingPlanCommentOk(data) {
        return !('comment' in data) ||
          (data.comment is string && data.comment.size() <= 200);
      }
      // Window: 15m–12h; start may not be more than 30d in the future.
      function spotTrainingPlanWindowOk(data) {
        return data.plannedStartAt is timestamp
          && data.plannedEndAt is timestamp
          && data.plannedEndAt > data.plannedStartAt
          && data.plannedEndAt >= data.plannedStartAt + duration.value(15, 'm')
          && data.plannedEndAt <= data.plannedStartAt + duration.value(12, 'h')
          && data.plannedStartAt <= request.time + duration.value(30, 'd');
      }
      function spotTrainingPlanCreateShape() {
        return request.resource.data.userId == request.auth.uid
          && request.resource.data.spotId is string
          && request.resource.data.spotId.size() > 0
          && request.resource.data.isPrivate is bool
          && request.resource.data.createdAt == request.time
          && spotTrainingPlanWindowOk(request.resource.data)
          && request.resource.data.plannedEndAt > request.time
          && !('planReminderSentAt' in request.resource.data)
          && spotTrainingPlanCommentOk(request.resource.data)
          && (!('spotName' in request.resource.data) ||
            (request.resource.data.spotName is string &&
              request.resource.data.spotName.size() <= 500));
      }
      // Set only by Cloud Functions; clients may delete when rescheduling.
      function spotTrainingPlanPlanReminderSentAtOk() {
        return !('planReminderSentAt' in request.resource.data) ||
          (('planReminderSentAt' in resource.data) &&
            request.resource.data.planReminderSentAt == resource.data.planReminderSentAt);
      }
      function spotTrainingPlanUpdateShape() {
        return request.auth != null
          && request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.spotId == resource.data.spotId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.isPrivate is bool
          && spotTrainingPlanWindowOk(request.resource.data)
          && spotTrainingPlanPlanReminderSentAtOk()
          && ((!('displayName' in resource.data)
                && !('displayName' in request.resource.data))
              || request.resource.data.displayName == resource.data.displayName)
          && ((!('photoURL' in resource.data)
                && !('photoURL' in request.resource.data))
              || request.resource.data.photoURL == resource.data.photoURL)
          && ((!('spotName' in resource.data)
                && !('spotName' in request.resource.data))
              || request.resource.data.spotName == resource.data.spotName)
          && spotTrainingPlanCommentOk(request.resource.data);
      }
      allow read: if resource.data.isPrivate == false
        || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if request.auth != null && spotTrainingPlanCreateShape();
      allow update: if request.auth != null && spotTrainingPlanUpdateShape();
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Users collection - users can only manage their own profile, admins can read/update all
    // Public profiles (isPublicProfile == true) are readable by anyone
    match /users/{userId} {
      // Allow read if:
      // 1. User is reading their own profile, OR
      // 2. User is an admin, OR
      // 3. Profile is public (isPublicProfile == true, defaulting to true if field doesn't exist)
      allow read: if request.auth != null && 
        (request.auth.uid == userId ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)) ||
        (resource.data.isPublicProfile == true || !('isPublicProfile' in resource.data));
      // Allow create only for self and forbid setting privileged flags
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isModerator == false;
      // Allow update for self but prevent privilege escalation on admin/moderator flags
      // Admins can update moderator status for any user
      allow update: if request.auth != null && 
        ((request.auth.uid == userId &&
          // Handle missing fields by defaulting to false
          // If field not in request.resource, it's unchanged, so use resource value (or false if missing)
          ('isAdmin' in request.resource.data ? request.resource.data.isAdmin : ('isAdmin' in resource.data ? resource.data.isAdmin : false)) == 
          ('isAdmin' in resource.data ? resource.data.isAdmin : false) &&
          ('isModerator' in request.resource.data ? request.resource.data.isModerator : ('isModerator' in resource.data ? resource.data.isModerator : false)) == 
          ('isModerator' in resource.data ? resource.data.isModerator : false)) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true &&
          // Admins can only update isModerator flag, not isAdmin
          // Handle case where isAdmin field might not exist in old documents
          // If isAdmin not in request.resource, it's unchanged, so use resource value (or false if missing)
          ('isAdmin' in request.resource.data ? request.resource.data.isAdmin : ('isAdmin' in resource.data ? resource.data.isAdmin : false)) == 
          ('isAdmin' in resource.data ? resource.data.isAdmin : false)));

      // Private bookmarks of others' spot lists (only the owner can read/write)
      match /savedSpotLists/{listId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      // Per-user location anchors used for nearby notification targeting.
      match /locationsOfInterest/{docId} {
        function hasValidLocationFields(data) {
          return data.latitude is number &&
            data.longitude is number &&
            data.latitude >= -90 && data.latitude <= 90 &&
            data.longitude >= -180 && data.longitude <= 180 &&
            data.enabled is bool &&
            data.kind is string &&
            data.kind in ['lastKnown', 'saved'] &&
            (!('label' in data) || data.label is string) &&
            data.userId is string &&
            data.userId == userId;
        }

        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          hasValidLocationFields(request.resource.data);
        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          resource.data.userId == userId &&
          hasValidLocationFields(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // In-app notifications inbox (documents written by Admin SDK / Cloud Functions only).
      match /notifications/{notificationId} {
        function notificationStringsOk(data) {
          return (!('title' in data) ||
            (data.title is string &&
              data.title.size() > 0 &&
              data.title.size() <= 200)) &&
            (!('body' in data) ||
              (data.body is string && data.body.size() <= 2000));
        }
        function notificationKindOk(data) {
          return !('notificationKind' in data) ||
            (data.notificationKind is string &&
              data.notificationKind.size() > 0 &&
              data.notificationKind.size() <= 64 &&
              data.notificationKind in ['nearby_new_spot', 'nearby_check_in', 'training_plan_check_in_reminder']);
        }
        function notificationTemplateArgsOk(data) {
          return !('templateArgs' in data) || (
            data.templateArgs is map &&
            data.templateArgs.size() <= 4 &&
            (!('actorName' in data.templateArgs) ||
              (data.templateArgs.actorName is string &&
                data.templateArgs.actorName.size() <= 200)) &&
            (!('spotName' in data.templateArgs) ||
              (data.templateArgs.spotName is string &&
                data.templateArgs.spotName.size() <= 200))
          );
        }
        function notificationDeeplinkOk(data) {
          return data.deeplinkKind is string &&
            data.deeplinkKind in ['spot', 'profile'] &&
            data.deeplinkId is string &&
            data.deeplinkId.size() > 0 &&
            data.deeplinkId.size() <= 200;
        }
        function notificationReadShape(data) {
          return !('read' in data) || data.read is bool;
        }
        function notificationReadStatusPatchOnly() {
          return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
        }

        // List queries must not use field checks the query cannot guarantee for every
        // matching document (see Firestore "rules are not filters"). Clients cannot
        // create docs here; only validate shape on update (toggle read / unread).
        allow read: if request.auth != null &&
          (request.auth.uid == userId || requestingUserIsAdmin());
        allow create: if false;
        allow delete: if requestingUserIsAdmin();
        allow update: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.read is bool &&
          notificationReadStatusPatchOnly() &&
          notificationReadShape(request.resource.data) &&
          notificationStringsOk(request.resource.data) &&
          notificationKindOk(request.resource.data) &&
          notificationTemplateArgsOk(request.resource.data) &&
          notificationDeeplinkOk(request.resource.data);
      }
    }
    
    // Ratings collection - users can read all ratings, authenticated users can create their own
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Spot reports - anyone can submit, only moderators/admins can view or manage
    match /spotReports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
    }

    // Comments collection - users can read all comments, authenticated users can create, owners can edit/delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // SyncSources collection - all sync sources are public
    match /syncSources/{sourceId} {
      allow read: if true; // Allow all users to read sync sources
      // Only allow admin users to write (this would be handled by Firebase Functions with admin privileges)
    }
    
    // AuditLog collection - logs moderator actions on spots
    match /auditLog/{logId} {
      // Only moderators and admins can read audit logs
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      // Only moderators and admins can create audit log entries (when performing actions)
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true) &&
        // Ensure the userId in the log matches the authenticated user
        request.resource.data.userId == request.auth.uid;
      // No updates or deletes allowed (immutable audit log)
      allow update, delete: if false;
    }

    // SpotLists collection - users manage their own lists, visibility controls read access
    match /spotLists/{listId} {
      function hasValidSpotListVisibility(data) {
        return !('visibility' in data) ||
          data.visibility in ['public', 'unlisted', 'private'];
      }
      function canReadSpotList(data) {
        // Legacy lists without visibility default to unlisted behavior.
        return !('visibility' in data) ||
          data.visibility == 'public' ||
          data.visibility == 'unlisted';
      }

      // Owners can always read; others can only read public/unlisted lists.
      allow read: if (request.auth != null &&
        resource.data.createdBy == request.auth.uid) ||
        canReadSpotList(resource.data);
      // Users can create lists (service validates feature access)
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        hasValidSpotListVisibility(request.resource.data);
      // Users can update their own lists
      allow update: if request.auth != null &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        hasValidSpotListVisibility(request.resource.data);
      // Users can delete their own lists
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }

    // DuplicateDetectionResults collection - moderators and admins can read
    match /duplicateDetectionResults/{runId} {
      // Moderators and admins can read duplicate detection results
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true);
      // Only Cloud Functions (with admin privileges) can create/delete
      allow create, delete: if false;
      // Moderators and admins can update the collapsedPairs field for UI preferences
      allow update: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true) &&
        // Ensure collapsedPairs is a list if present
        (!('collapsedPairs' in request.resource.data) || request.resource.data.collapsedPairs is list);
    }

    // UserActivityMetrics collection - only admins can read, only Cloud Functions can write
    match /userActivityMetrics/{dateId} {
      // Only admins can read activity metrics
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      // Only Cloud Functions (with admin privileges) can create/update/delete
      allow create, update, delete: if false;
    }

    // ApiClients collection - only Cloud Functions (admin SDK) read/write
    // Flutter admin UI uses callables (getApiClients, etc.) which run as admin
    match /apiClients/{clientId} {
      allow read, write: if false;
      match /usage/{dateId} {
        allow read, write: if false;
      }
    }

    // SpotJumpflixVideos collection - Jumpflix video IDs linked to spots (nightly import)
    // Public read so app can show "Watch on Jumpflix" for spots; only Cloud Functions write
    match /spotJumpflixVideos/{spotId} {
      allow read: if true;
      allow write: if false;
    }

    // JumpflixVideos collection - video details (title, description, url, thumbnailUrl)
    // Public read; only Cloud Functions write
    match /jumpflixVideos/{videoId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
