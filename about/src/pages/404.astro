---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenInApp from "../components/OpenInApp.astro";
import {appHomeUrl} from "../lib/urls";

const description =
  "This page isn't on about.parkour.spot. Head home, browse events, or open the app to keep exploring.";
---

<BaseLayout
  title="Page not found"
  description={description}
  noIndex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__badge" aria-hidden="true">
      <img
        class="not-found__logo"
        src="/logo-square.svg"
        alt=""
        width="72"
        height="72"
      />
      <p class="not-found__code">404</p>
    </div>
    <h1 class="not-found__title" id="not-found-title">Page not found</h1>
    <p class="not-found__lede">
      That link does not match anything here—maybe the page moved, ended, or
      never existed. If you typed the URL, double-check it and try again.
    </p>
    <p class="muted not-found__path">
      <span class="visually-hidden">Requested path: </span>
      <code class="not-found__path-value" data-not-found-path></code>
    </p>
    <div class="not-found__actions hero__actions">
      <a class="btn btn--primary" href="/">Back to about</a>
      <a class="btn btn--outlined" href="/events">Browse events</a>
      <OpenInApp href={appHomeUrl()} label="Open the app" />
    </div>
  </section>
  <script is:inline>
    const el = document.querySelector("[data-not-found-path]");
    if (el) {
      const path = window.location.pathname + window.location.search;
      el.textContent = path || "/";
    }
  </script>
</BaseLayout>
