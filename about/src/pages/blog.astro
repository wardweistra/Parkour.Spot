---
import BaseLayout from "../layouts/BaseLayout.astro";
import {SITE_NAME} from "../lib/brand";
---

<BaseLayout
  title="Blog"
  description={`Release notes and updates from ${SITE_NAME}.`}
  canonicalPath="/blog"
>
  <h1 class="page-title">Blog</h1>
  <p class="page-lede">
    Release notes and community updates will be published here as Markdown in
    this repo.
  </p>
  <p class="empty">No posts yet.</p>
</BaseLayout>
