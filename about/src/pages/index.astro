---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenInApp from "../components/OpenInApp.astro";
import {listCityParams, loadAboutIndex} from "../lib/snapshots";
import {SITE_NAME} from "../lib/brand";
import {aboutCountryPath, appHomeUrl} from "../lib/urls";

const index = await loadAboutIndex();
const cityCountByCountry = new Map<string, number>();
for (const city of await listCityParams()) {
  const code = city.countryCode.toLowerCase();
  cityCountByCountry.set(code, (cityCountByCountry.get(code) ?? 0) + 1);
}
---

<BaseLayout
  title={SITE_NAME}
  description="A community atlas for discovering, rating, and sharing parkour spots worldwide — open to explore, built with the community."
  canonicalPath="/"
>
  <section class="hero">
    <h1 class="hero__brand">{SITE_NAME}</h1>
    <p class="hero__lead">
      Find trustworthy places to train, understand them quickly, and pass them
      on. Core discovery stays open — no login wall on the map.
    </p>
    <div class="hero__actions">
      <OpenInApp href={appHomeUrl()} label="Open the map" />
      <a class="btn btn--outlined" href="/events">Browse events</a>
    </div>
  </section>

  <section class="section prose">
    <h2 class="section__title">What this site is for</h2>
    <p>
      The main app at parkour.spot is a Flutter web map. This site publishes
      crawlable pages — explanations, area hubs, and events — so search engines
      and people landing from the web can read the same community knowledge in
      plain HTML.
    </p>
  </section>

  {
    index.countries.length > 0 && (
      <section class="section">
        <h2 class="section__title">Area hubs</h2>
        <p class="section__hint">
          Daily snapshots of places with enough rated spots. Paths match the
          app (for example /nl/amsterdam).
        </p>
        <div class="chip-row">
          {index.countries.map((c) => {
            const cityCount = cityCountByCountry.get(c.code.toLowerCase()) ?? 0;
            return (
              <a class="chip" href={aboutCountryPath(c.code)}>
                {c.code.toUpperCase()}
                <span class="muted">
                  {" "}
                  · {cityCount} {cityCount === 1 ? "city" : "cities"}
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )
  }
</BaseLayout>
