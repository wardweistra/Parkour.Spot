---
import BaseLayout from "../layouts/BaseLayout.astro";
import OpenInApp from "../components/OpenInApp.astro";
import {SITE_NAME} from "../lib/brand";
import {
  APP_DEFINITION,
  countryName,
  coverageSentence,
} from "../lib/citation";
import {buildSiteGraph} from "../lib/schema";
import {loadCoverage} from "../lib/snapshots";
import {aboutCityPath, aboutCountryPath, appHomeUrl} from "../lib/urls";

const coverage = await loadCoverage();
const countryCount = coverage.countries.length;
const cityCount = coverage.countries.reduce(
  (sum, country) => sum + country.cities.length,
  0,
);
const spotCount = coverage.countries.reduce(
  (sum, country) => sum + country.spotCount,
  0,
);
const facts = coverageSentence({
  spotCount,
  cityCount,
  countryCount,
  generatedAt: coverage.generatedAt,
});

const netherlands = coverage.countries.find((country) => country.code === "nl");
const amsterdam = netherlands?.cities.find(
  (city) => city.citySlug === "amsterdam",
);
const exampleCountry = amsterdam && netherlands ? netherlands : coverage.countries[0];
const exampleCity = amsterdam ?? exampleCountry?.cities[0];
const examplePath =
  exampleCountry && exampleCity
    ? aboutCityPath(exampleCountry.code, exampleCity.citySlug)
    : null;

const countries = [...coverage.countries].sort((a, b) =>
  countryName(a.code).localeCompare(countryName(b.code), "en"),
);
---

<BaseLayout
  title={SITE_NAME}
  description={APP_DEFINITION}
  canonicalPath="/"
  jsonLd={buildSiteGraph()}
>
  <section class="hero">
    <h1 class="hero__brand">{SITE_NAME}</h1>
    <p class="hero__lead">{APP_DEFINITION}</p>
    <div class="hero__actions">
      <OpenInApp href={appHomeUrl()} label="Open the map" />
      <a class="btn btn--outlined" href="/events">Browse events</a>
    </div>
  </section>

  <section class="section prose">
    <h2 class="section__title">The public atlas</h2>
    {facts && <p>{facts}</p>}
    <p>
      Country and city pages use the same paths as the map at{" "}
      <a href={appHomeUrl()}>parkour.spot</a>.{" "}
      {
        examplePath && (
          <>
            The same path works on both sites, for example{" "}
            <a href={examplePath}>{examplePath}</a>.{" "}
          </>
        )
      }
      <a href="/how-it-works">How {SITE_NAME} works</a> covers the map, ratings,
      photos, and events.
    </p>
  </section>

  {
    countries.length > 0 && (
      <section class="section">
        <h2 class="section__title">Countries</h2>
        <div class="chip-row">
          {countries.map((country) => (
            <a class="chip" href={aboutCountryPath(country.code)}>
              {countryName(country.code)}
              <span class="muted">
                {" "}
                · {country.cities.length}{" "}
                {country.cities.length === 1 ? "city" : "cities"}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
