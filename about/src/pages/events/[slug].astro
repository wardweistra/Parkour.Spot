---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import CountryFlag from "../../components/CountryFlag.astro";
import {buildEventJsonLd} from "../../lib/schema";
import {listEventSlugs, loadCity, loadCountry, loadEvent} from "../../lib/snapshots";
import {appEventUrl, cityHubKey, eventAreaHubLink} from "../../lib/urls";

export async function getStaticPaths() {
  const slugs = await listEventSlugs();
  return slugs.map((slug) => ({params: {slug}}));
}

const {slug} = Astro.params;
const event = slug ? await loadEvent(slug) : null;

if (!event) {
  return Astro.redirect("/events");
}

const dateOnly = event.isDateOnly;
const jsonLd = buildEventJsonLd(event);
const description =
  event.description?.slice(0, 160) ||
  `Parkour event: ${event.title}`;

function formatWhen(iso: string | null): string {
  if (!iso) return "Date TBA";
  try {
    return new Intl.DateTimeFormat("en", {
      dateStyle: "full",
      timeStyle: dateOnly ? undefined : "short",
    }).format(new Date(iso));
  } catch {
    return iso;
  }
}

const heroImage =
  event.imageUrls?.[0] || event.imageUrl || null;

const placeLabel = event.address?.trim() || event.placeName?.trim() || "";
const countryCode = event.countryCode?.trim().toLowerCase() ?? "";
const citySlug = event.citySlug?.trim() ?? "";
const cityHub =
  countryCode && citySlug ? await loadCity(countryCode, citySlug) : null;
const countryHub =
  !cityHub && countryCode ? await loadCountry(countryCode) : null;
const areaHub = eventAreaHubLink(
  event,
  cityHub ? new Set([cityHubKey(countryCode, citySlug)]) : new Set(),
  countryHub ? new Set([countryCode]) : new Set(),
);
---

<BaseLayout
  title={event.title}
  description={description}
  canonicalPath={`/events/${event.slug}`}
  jsonLd={jsonLd}
>
  <article class="event-hero">
    <div>
      <h1 class="page-title">{event.title}</h1>
      <p class="page-lede">{formatWhen(event.startAt)}</p>
      {
        event.city && event.countryCode && (
          <p class="muted">
            {placeLabel ? `${placeLabel} · ` : ""}
            <CountryFlag code={event.countryCode} />
            {event.city}, {event.countryCode.toUpperCase()}
            {areaHub && (
              <>
                {" · "}
                <a href={areaHub.href}>{areaHub.label}</a>
              </>
            )}
          </p>
        )
      }
      <div class="hero__actions" style="margin-top: 1.5rem;">
        <OpenInApp href={appEventUrl(event.eventId)} />
        {
          event.websiteUrl && (
            <a class="btn btn--outlined" href={event.websiteUrl} rel="noopener noreferrer">
              Event website
            </a>
          )
        }
      </div>
      {
        event.description && (
          <div class="section prose">
            <h2 class="section__title">About this event</h2>
            <p>{event.description}</p>
          </div>
        )
      }
    </div>
    {
      heroImage && (
        <div class="event-hero__image">
          <img src={heroImage} alt="" loading="eager" />
        </div>
      )
    }
  </article>
</BaseLayout>
