---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CountryFlag from "../../components/CountryFlag.astro";
import EventList from "../../components/EventList.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import {formatEventWhen} from "../../lib/calendar";
import {
  countryInPhrase,
  countryName,
  eventInterestPushLine,
  metaDescription,
} from "../../lib/citation";
import {buildEventJsonLd} from "../../lib/schema";
import {listEventSlugs, loadCity, loadCountry, loadEvent} from "../../lib/snapshots";
import {
  aboutCityPath,
  aboutCountryPath,
  aboutEventsPath,
  appEventUrl,
  appSpotUrl,
} from "../../lib/urls";

export async function getStaticPaths() {
  const slugs = await listEventSlugs();
  return slugs.map((slug) => ({params: {slug}}));
}

const {slug} = Astro.params;
const event = slug ? await loadEvent(slug) : null;

if (!event) {
  return Astro.redirect("/events");
}

const jsonLd = buildEventJsonLd(event);
const description = event.description?.trim()
  ? metaDescription(event.description)
  : `Parkour event: ${event.title}`;
const whenLabel = formatEventWhen(event);

const heroImage =
  event.imageUrls?.[0] || event.imageUrl || null;

const placeLabel = event.address?.trim() || event.placeName?.trim() || "";
const placeIsSpot =
  !event.address?.trim() &&
  Boolean(
    event.placeName?.trim() &&
      event.placeSpotId &&
      event.placeSpotCitySlug &&
      event.countryCode,
  );
const placeSpotHref = placeIsSpot
  ? appSpotUrl(
      event.countryCode!,
      event.placeSpotCitySlug!,
      event.placeSpotId!,
    )
  : null;

const countryCode = event.countryCode?.trim().toLowerCase() ?? "";
const citySlug = event.citySlug?.trim() ?? "";
const countryHub = countryCode ? await loadCountry(countryCode) : null;
const cityHub =
  countryCode && citySlug ? await loadCity(countryCode, citySlug) : null;

const spotsHubHref = cityHub
  ? aboutCityPath(countryCode, citySlug)
  : countryHub
    ? aboutCountryPath(countryCode)
    : null;
const spotsHubLabel = cityHub
  ? `Spots in ${cityHub.city}`
  : countryHub
    ? `Spots in ${countryInPhrase(countryCode)}`
    : null;

const relatedSource = cityHub?.events?.length
  ? cityHub.events
  : (countryHub?.events ?? []);
const relatedPlace = cityHub?.city || (countryCode ? countryName(countryCode) : "");
const related = relatedSource
  .filter(
    (item) => item.slug !== event.slug && item.eventId !== event.eventId,
  )
  .slice(0, 5);

const aboutBody = event.description?.trim() || "";
const interestLine = eventInterestPushLine(event);
---

<BaseLayout
  title={event.title}
  description={description}
  canonicalPath={`/events/${event.slug}`}
  jsonLd={jsonLd}
  image={heroImage}
  imageAlt={event.title}
>
  <article class="event-hero">
    {
      heroImage && (
        <div class="event-hero__image">
          <img src={heroImage} alt={event.title} loading="eager" />
        </div>
      )
    }
    <div class="event-hero__text">
      <h1 class="page-title">{event.title}</h1>
      <p class="page-lede">{whenLabel}</p>
      <nav class="muted event-trail" aria-label="Events">
        <a href={aboutEventsPath()}>Events</a>
        {
          countryCode && (
            <>
              <span aria-hidden="true"> › </span>
              <a href={aboutEventsPath({country: countryCode})}>
                {countryName(countryCode)}
              </a>
            </>
          )
        }
      </nav>
      {
        (event.city && event.countryCode) || spotsHubHref ? (
          <p class="muted">
            {
              event.city && event.countryCode && (
                <>
                  {
                    placeLabel && (
                      <>
                        {
                          placeSpotHref ? (
                            <a href={placeSpotHref}>{placeLabel}</a>
                          ) : (
                            placeLabel
                          )
                        }
                        {" · "}
                      </>
                    )
                  }
                  <CountryFlag code={event.countryCode} />
                  {event.city}, {event.countryCode.toUpperCase()}
                </>
              )
            }
            {
              spotsHubHref && spotsHubLabel && (
                <>
                  {event.city && event.countryCode ? " · " : ""}
                  <a href={spotsHubHref}>{spotsHubLabel}</a>
                </>
              )
            }
          </p>
        ) : null
      }
      <div class="hero__actions event-hero__actions">
        <OpenInApp href={appEventUrl(event.eventId)} />
        {
          event.websiteUrl && (
            <a
              class="btn btn--outlined"
              href={event.websiteUrl}
              rel="noopener noreferrer"
            >
              Event website
            </a>
          )
        }
      </div>
      {
        interestLine && (
          <p class="muted event-interest">{interestLine}</p>
        )
      }
      {
        aboutBody && (
          <div class="section prose">
            <h2 class="section__title">About this event</h2>
            <p>{aboutBody}</p>
          </div>
        )
      }
      {
        related.length > 0 && relatedPlace && (
          <section class="section" aria-labelledby="related-events-title">
            <h2 class="section__title" id="related-events-title">
              More events in {relatedPlace}
            </h2>
            <EventList events={related} />
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>
