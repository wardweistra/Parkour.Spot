---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventList from "../../components/EventList.astro";
import {SITE_NAME} from "../../lib/brand";
import {listCityParams, listCountryCodes, loadEventsIndex} from "../../lib/snapshots";
import {appHomeUrl, cityHubKey} from "../../lib/urls";
import OpenInApp from "../../components/OpenInApp.astro";

const index = await loadEventsIndex();
const cityHubKeys = (await listCityParams()).map((city) =>
  cityHubKey(city.countryCode, city.city),
);
const countryHubCodes = await listCountryCodes();
---

<BaseLayout
  title="Events"
  description={`Upcoming public parkour events from the ${SITE_NAME} community, refreshed daily.`}
  canonicalPath="/events"
>
  <h1 class="page-title">Events</h1>
  <p class="page-lede">
    Upcoming public parkour events from the {SITE_NAME} community. Open an
    event for the time and place, or jump into the map.
  </p>
  <div class="hub-open">
    <OpenInApp href={appHomeUrl()} label="Open the map" />
  </div>
  <EventList
    events={index.events}
    cityHubKeys={cityHubKeys}
    countryHubCodes={countryHubCodes}
  />
</BaseLayout>
