---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventCalendar from "../../components/EventCalendar.astro";
import {SITE_NAME} from "../../lib/brand";
import {upcomingEventsPhrase} from "../../lib/citation";
import {buildEventsListJsonLd} from "../../lib/schema";
import {loadEventsIndex, loadStats} from "../../lib/snapshots";
import {appHomeUrl, appPath} from "../../lib/urls";
import OpenInApp from "../../components/OpenInApp.astro";

const index = await loadEventsIndex();
const stats = await loadStats();
const phrase = upcomingEventsPhrase({
  ...stats,
  upcomingEventCount: stats.upcomingEventCount ?? index.events.length,
});
const description = phrase
  ? `${phrase.charAt(0).toUpperCase()}${phrase.slice(1)} on ${SITE_NAME}: jams, workshops, and gatherings from the parkour community.`
  : `Upcoming public parkour events from the ${SITE_NAME} community.`;
---

<BaseLayout
  title="Events"
  description={description}
  canonicalPath="/events"
  jsonLd={buildEventsListJsonLd(index.events)}
>
  <h1 class="page-title">Events</h1>
  <p class="page-lede">
    {description} Open an event for the time and place, or see them all on the
    map. Organizing one? <a href={appPath("/events/add")}>Add your event</a>, and
    a moderator will check it before it goes live.
  </p>
  <div class="hub-open">
    <OpenInApp href={appHomeUrl()} label="Open the map" />
  </div>
  <EventCalendar
    events={index.events}
    generatedAt={index.generatedAt}
    showFlags
    showCountryFilter
  />
</BaseLayout>
