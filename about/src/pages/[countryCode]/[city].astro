---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpotList from "../../components/SpotList.astro";
import EventCalendar from "../../components/EventCalendar.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import CountryFlag from "../../components/CountryFlag.astro";
import {
  cityHubLede,
  cityHubTitle,
  countryName,
  metaDescription,
  moreOnMapLabel,
  resolveSpotCount,
  worldwideContext,
} from "../../lib/citation";
import {SITE_NAME} from "../../lib/brand";
import {qualifyingSpots} from "../../lib/ratings";
import {buildPlaceJsonLd} from "../../lib/schema";
import {
  listCityParams,
  loadCity,
  loadCountry,
  loadStats,
} from "../../lib/snapshots";
import {
  aboutAbsolute,
  aboutCityPath,
  aboutCountryPath,
  appCityUrl,
} from "../../lib/urls";

export async function getStaticPaths() {
  const cities = await listCityParams();
  return cities.map(({countryCode, city}) => ({
    params: {countryCode, city},
  }));
}

const {countryCode, city: citySlug} = Astro.params;
if (
  !countryCode ||
  !citySlug ||
  !/^[a-zA-Z]{2}$/.test(countryCode)
) {
  return Astro.redirect("/");
}

const hub = await loadCity(countryCode, citySlug);
if (!hub) {
  return Astro.redirect(`/${countryCode.toLowerCase()}`);
}

const cc = hub.countryCode.toLowerCase();
const listed = hub.spots ?? [];
const country = await loadCountry(cc);
const cityRef = country?.cities?.find((city) => city.citySlug === hub.citySlug);
const spotCount = resolveSpotCount(
  hub.spotCount ?? cityRef?.spotCount,
  listed.length,
);
const eventCount = hub.events.length;
const title = cityHubTitle(hub.city, {spotCount, eventCount});
const topNames = qualifyingSpots(listed).slice(0, 3).map((spot) => spot.name);
const lede = cityHubLede({
  city: hub.city,
  spotCount,
  listedCount: listed.length,
  topNames,
  eventCount,
});
const worldwide = worldwideContext(await loadStats());
const moreLabel = moreOnMapLabel(spotCount, listed.length);
const pagePath = aboutCityPath(cc, hub.citySlug);
const jsonLd = buildPlaceJsonLd({
  name: title,
  pageUrl: aboutAbsolute(pagePath),
  spots: listed,
  breadcrumbs: [
    {name: SITE_NAME, url: aboutAbsolute("/")},
    {name: countryName(cc), url: aboutAbsolute(aboutCountryPath(cc))},
    {name: hub.city, url: aboutAbsolute(pagePath)},
  ],
});
---

<BaseLayout
  title={title}
  description={metaDescription(lede ?? title)}
  canonicalPath={pagePath}
  jsonLd={jsonLd}
>
  <p class="muted">
    <a href={aboutCountryPath(cc)}><CountryFlag code={cc} />{countryName(cc)}</a>
    · {hub.city}
  </p>
  <h1 class="page-title">{title}</h1>
  {lede && <p class="page-lede">{lede}</p>}
  <div class="hub-open">
    <OpenInApp href={appCityUrl(cc, hub.citySlug)} />
  </div>

  <section class="section">
    <h2 class="section__title">Upcoming events</h2>
    <EventCalendar
      events={hub.events}
      generatedAt={hub.generatedAt}
      showPlaceLinks={false}
      headingLevel={3}
    />
  </section>

  {
    listed.length > 0 && (
      <section class="section">
        <h2 class="section__title">Spots</h2>
        <SpotList spots={listed} />
        {moreLabel && (
          <p class="more-link">
            <a href={appCityUrl(cc, hub.citySlug)}>{moreLabel}</a>
          </p>
        )}
      </section>
    )
  }

  {
    worldwide && (
      <p class="muted hub-context">
        {worldwide} <a href="/">About {SITE_NAME}</a>
      </p>
    )
  }

</BaseLayout>
