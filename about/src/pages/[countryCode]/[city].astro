---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpotList from "../../components/SpotList.astro";
import EventList from "../../components/EventList.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import {qualifyingSpots} from "../../lib/ratings";
import {listCityParams, loadCity} from "../../lib/snapshots";
import {aboutCountryPath, appCityUrl} from "../../lib/urls";

export async function getStaticPaths() {
  const cities = await listCityParams();
  return cities.map(({countryCode, city}) => ({
    params: {countryCode, city},
  }));
}

const {countryCode, city: citySlug} = Astro.params;
if (
  !countryCode ||
  !citySlug ||
  !/^[a-zA-Z]{2}$/.test(countryCode)
) {
  return Astro.redirect("/");
}

const hub = await loadCity(countryCode, citySlug);
if (!hub || qualifyingSpots(hub.spots).length === 0) {
  return Astro.redirect(`/${countryCode.toLowerCase()}`);
}

const cc = hub.countryCode.toLowerCase();
const title = `${hub.city} · ${cc.toUpperCase()}`;
---

<BaseLayout
  title={title}
  description={`Best-rated parkour spots and upcoming events in ${hub.city}, ${cc.toUpperCase()}.`}
  canonicalPath={`/${cc}/${hub.citySlug}`}
>
  <p class="muted">
    <a href={aboutCountryPath(cc)}>{cc.toUpperCase()}</a>
    · {hub.city}
  </p>
  <h1 class="page-title">{hub.city}</h1>
  <p class="page-lede">
    Area hub with the same path as the app — open it there to explore on the
    map.
  </p>
  <div class="hub-open">
    <OpenInApp href={appCityUrl(cc, hub.citySlug)} />
  </div>

  <section class="section">
    <h2 class="section__title">Best-rated spots</h2>
    <SpotList spots={hub.spots} />
  </section>

  <section class="section">
    <h2 class="section__title">Upcoming events</h2>
    <EventList events={hub.events} showPlaceLinks={false} />
  </section>

  <section class="section">
    <h2 class="section__title">Local knowledge</h2>
    <p class="section__hint">
      Gyms, classes, and community groups for {hub.city} will appear here when
      we have verified listings.
    </p>
  </section>

  <section class="section">
    <h2 class="section__title">Community activity</h2>
    <p class="section__hint">
      Check-ins and local activity summaries are planned for a later refresh.
    </p>
  </section>
</BaseLayout>
