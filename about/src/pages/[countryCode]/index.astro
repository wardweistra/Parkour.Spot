---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpotList from "../../components/SpotList.astro";
import EventList from "../../components/EventList.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import {listCountryCodes, loadCountry} from "../../lib/snapshots";
import {
  aboutCityPath,
  appCountryUrl,
} from "../../lib/urls";

export async function getStaticPaths() {
  const codes = await listCountryCodes();
  return codes.map((countryCode) => ({params: {countryCode}}));
}

const {countryCode} = Astro.params;
if (!countryCode || !/^[a-zA-Z]{2}$/.test(countryCode)) {
  return Astro.redirect("/");
}

const country = await loadCountry(countryCode);
if (!country) {
  return Astro.redirect("/");
}

const cc = country.countryCode.toLowerCase();
const title = `${cc.toUpperCase()} · Parkour spots and events`;
---

<BaseLayout
  title={title}
  description={`Best-rated parkour spots and upcoming events in ${cc.toUpperCase()}, refreshed daily from ParkourSpot.`}
  canonicalPath={`/${cc}`}
>
  <h1 class="page-title">{cc.toUpperCase()}</h1>
  <p class="page-lede">
    Area hub for this country — top-rated spots, upcoming events, and city
    pages that mirror the app URLs.
  </p>
  <div class="hub-open">
    <OpenInApp href={appCountryUrl(cc)} />
  </div>

  <section class="section">
    <h2 class="section__title">Cities</h2>
    {
      country.cities.length === 0 ? (
        <p class="empty">No eligible cities in this snapshot.</p>
      ) : (
        <div class="chip-row">
          {country.cities.map((city) => (
            <a class="chip" href={aboutCityPath(cc, city.citySlug)}>
              {city.city}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="section">
    <h2 class="section__title">Best-rated spots</h2>
    <SpotList spots={country.spots} />
  </section>

  <section class="section">
    <h2 class="section__title">Upcoming events</h2>
    <EventList events={country.events} />
  </section>

  <section class="section">
    <h2 class="section__title">Local knowledge</h2>
    <p class="section__hint">
      Gyms, classes, and community groups for this area will appear here when
      we have verified listings.
    </p>
  </section>
</BaseLayout>
