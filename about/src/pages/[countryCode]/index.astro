---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpotList from "../../components/SpotList.astro";
import EventCalendar from "../../components/EventCalendar.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import CountryFlag from "../../components/CountryFlag.astro";
import {
  countryHubLede,
  countryHubTitle,
  countryName,
  metaDescription,
  moreOnMapLabel,
  resolveSpotCount,
  worldwideContext,
} from "../../lib/citation";
import {SITE_NAME} from "../../lib/brand";
import {qualifyingSpots} from "../../lib/ratings";
import {buildPlaceJsonLd} from "../../lib/schema";
import {
  listCountryCodes,
  loadCityRefs,
  loadCountry,
  loadStats,
} from "../../lib/snapshots";
import {
  aboutAbsolute,
  aboutCityPath,
  aboutCountryPath,
  appCountryUrl,
  cityHubKey,
} from "../../lib/urls";

export async function getStaticPaths() {
  const codes = await listCountryCodes();
  return codes.map((countryCode) => ({params: {countryCode}}));
}

const {countryCode} = Astro.params;
if (!countryCode || !/^[a-zA-Z]{2}$/.test(countryCode)) {
  return Astro.redirect("/");
}

const country = await loadCountry(countryCode);
if (!country) {
  return Astro.redirect("/");
}

const cc = country.countryCode.toLowerCase();
const cities = [...(await loadCityRefs(country))].sort(
  (a, b) =>
    (b.spotCount ?? 0) - (a.spotCount ?? 0) || a.city.localeCompare(b.city, "en"),
);
const listed = country.spots ?? [];
const fromCities = cities.reduce((sum, city) => sum + (city.spotCount ?? 0), 0);
const spotCount = resolveSpotCount(country.spotCount, fromCities || listed.length);
const eventCount = country.events.length;
const title = countryHubTitle(cc, {spotCount, eventCount});
const topNames = qualifyingSpots(listed).slice(0, 3).map((spot) => spot.name);
const lede = countryHubLede({
  countryCode: cc,
  spotCount,
  cityNames: cities
    .filter((city) => (city.spotCount ?? 0) > 0)
    .map((city) => city.city),
  listedCount: listed.length,
  topNames,
  eventCount,
});
const worldwide = worldwideContext(await loadStats());
const moreLabel = moreOnMapLabel(spotCount, listed.length);
const pagePath = aboutCountryPath(cc);
const shareSpot = listed.find((spot) => spot.imageUrl);
const jsonLd = buildPlaceJsonLd({
  name: title,
  pageUrl: aboutAbsolute(pagePath),
  spots: listed,
  breadcrumbs: [
    {name: SITE_NAME, url: aboutAbsolute("/")},
    {name: countryName(cc), url: aboutAbsolute(pagePath)},
  ],
});
---

<BaseLayout
  title={title}
  description={metaDescription(lede)}
  canonicalPath={pagePath}
  jsonLd={jsonLd}
  image={shareSpot?.imageUrl}
  imageAlt={shareSpot ? `${shareSpot.name}, ${shareSpot.city}` : undefined}
>
  <h1 class="page-title"><CountryFlag code={cc} />{title}</h1>
  <p class="page-lede">{lede}</p>
  <div class="hub-open">
    <OpenInApp href={appCountryUrl(cc)} />
  </div>

  <section class="section">
    <h2 class="section__title">Upcoming events</h2>
    <EventCalendar
      events={country.events}
      generatedAt={country.generatedAt}
      cityHubKeys={cities.map((city) => cityHubKey(cc, city.citySlug))}
      headingLevel={3}
    />
  </section>

  {
    listed.length > 0 && (
      <section class="section">
        <h2 class="section__title">Spots</h2>
        <SpotList spots={listed} />
        {moreLabel && (
          <p class="more-link">
            <a href={appCountryUrl(cc)}>{moreLabel}</a>
          </p>
        )}
      </section>
    )
  }

  <section class="section">
    <h2 class="section__title">Cities</h2>
    {
      cities.length === 0 ? (
        <p class="empty">No cities yet.</p>
      ) : (
        <div class="chip-row">
          {cities.map((city) => (
            <a class="chip" href={aboutCityPath(cc, city.citySlug)}>
              {city.city}
              {(city.spotCount ?? 0) > 0 && (
                <span class="muted">
                  {" "}
                  · {city.spotCount} {city.spotCount === 1 ? "spot" : "spots"}
                </span>
              )}
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    worldwide && (
      <p class="muted hub-context">
        {worldwide} <a href="/">About {SITE_NAME}</a>
      </p>
    )
  }

</BaseLayout>
