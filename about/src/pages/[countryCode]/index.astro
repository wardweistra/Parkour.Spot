---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SpotList from "../../components/SpotList.astro";
import EventList from "../../components/EventList.astro";
import OpenInApp from "../../components/OpenInApp.astro";
import {
  countryHubLede,
  countryHubTitle,
  countryName,
  metaDescription,
  moreOnMapLabel,
  resolveSpotCount,
} from "../../lib/citation";
import {SITE_NAME} from "../../lib/brand";
import {buildPlaceJsonLd} from "../../lib/schema";
import {listCountryCodes, loadCityRefs, loadCountry} from "../../lib/snapshots";
import {
  aboutAbsolute,
  aboutCityPath,
  aboutCountryPath,
  appCountryUrl,
  cityHubKey,
} from "../../lib/urls";

export async function getStaticPaths() {
  const codes = await listCountryCodes();
  return codes.map((countryCode) => ({params: {countryCode}}));
}

const {countryCode} = Astro.params;
if (!countryCode || !/^[a-zA-Z]{2}$/.test(countryCode)) {
  return Astro.redirect("/");
}

const country = await loadCountry(countryCode);
if (!country) {
  return Astro.redirect("/");
}

const cc = country.countryCode.toLowerCase();
const cities = await loadCityRefs(country);
const listed = country.spots ?? [];
const fromCities = cities.reduce((sum, city) => sum + (city.spotCount ?? 0), 0);
const spotCount = resolveSpotCount(country.spotCount, fromCities || listed.length);
const title = countryHubTitle(cc);
const topNames = listed.slice(0, 3).map((spot) => spot.name);
const lede = countryHubLede({
  countryCode: cc,
  spotCount,
  cityNames: cities.map((city) => city.city),
  listedCount: listed.length,
  topNames,
});
const moreLabel = moreOnMapLabel(spotCount, listed.length);
const pagePath = aboutCountryPath(cc);
const jsonLd = buildPlaceJsonLd({
  name: title,
  pageUrl: aboutAbsolute(pagePath),
  spots: listed,
  breadcrumbs: [
    {name: SITE_NAME, url: aboutAbsolute("/")},
    {name: countryName(cc), url: aboutAbsolute(pagePath)},
  ],
});
---

<BaseLayout
  title={title}
  description={metaDescription(lede)}
  canonicalPath={pagePath}
  jsonLd={jsonLd}
>
  <h1 class="page-title">{title}</h1>
  <p class="page-lede">{lede}</p>
  <div class="hub-open">
    <OpenInApp href={appCountryUrl(cc)} />
  </div>

  <section class="section">
    <h2 class="section__title">Cities</h2>
    {
      cities.length === 0 ? (
        <p class="empty">No eligible cities in this snapshot.</p>
      ) : (
        <div class="chip-row">
          {cities.map((city) => (
            <a class="chip" href={aboutCityPath(cc, city.citySlug)}>
              {city.city}
              {(city.spotCount ?? 0) > 0 && (
                <span class="muted">
                  {" "}
                  · {city.spotCount} {city.spotCount === 1 ? "spot" : "spots"}
                </span>
              )}
            </a>
          ))}
        </div>
      )
    }
  </section>

  {
    listed.length > 0 && (
      <section class="section">
        <h2 class="section__title">Best-rated spots</h2>
        <SpotList spots={listed} />
        {moreLabel && (
          <p class="more-link">
            <a href={appCountryUrl(cc)}>{moreLabel}</a>
          </p>
        )}
      </section>
    )
  }

  <section class="section">
    <h2 class="section__title">Upcoming events</h2>
    <EventList
      events={country.events}
      cityHubKeys={cities.map((city) => cityHubKey(cc, city.citySlug))}
    />
  </section>

  <section class="section">
    <h2 class="section__title">Local knowledge</h2>
    <p class="section__hint">
      Gyms, classes, and community groups for this area will appear here when
      we have verified listings.
    </p>
  </section>
</BaseLayout>
