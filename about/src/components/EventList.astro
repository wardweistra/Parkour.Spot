---
import CountryFlag from "./CountryFlag.astro";
import type {EventSummary} from "../lib/types";
import {
  eventWhenLabel,
  formatMonthLabel,
  formatWeekdayAndDay,
  monthOf,
  zonedDayKey,
} from "../lib/calendar";
import {aboutEventPath} from "../lib/urls";

interface Props {
  events: EventSummary[];
  emptyLabel?: string;
}

const {
  events,
  emptyLabel = "No upcoming events.",
} = Astro.props;

type DayGroup = {
  key: string;
  label: string;
  events: EventSummary[];
};

type MonthGroup = {
  key: string;
  label: string;
  days: DayGroup[];
};

function groupEvents(items: EventSummary[]): MonthGroup[] {
  const months: MonthGroup[] = [];
  for (const event of items) {
    const dKey = zonedDayKey(event);
    const mKey = dKey ? monthOf(dKey) : "tba";
    let month = months.find((entry) => entry.key === mKey);
    if (!month) {
      month = {
        key: mKey,
        label: dKey ? formatMonthLabel(mKey) : "Date TBA",
        days: [],
      };
      months.push(month);
    }
    const dayGroupKey = dKey ?? "tba";
    let day = month.days.find((entry) => entry.key === dayGroupKey);
    if (!day) {
      day = {
        key: dayGroupKey,
        label: dKey ? formatWeekdayAndDay(dKey) : "Date TBA",
        events: [],
      };
      month.days.push(day);
    }
    day.events.push(event);
  }
  return months;
}

const months = groupEvents(events);

function placeLabel(event: EventSummary): string {
  return event.city && event.countryCode
    ? `${event.city}, ${event.countryCode.toUpperCase()}`
    : "";
}
---

{
  events.length === 0 ? (
    <p class="empty">{emptyLabel}</p>
  ) : (
    <div class="calendar">
      {months.map((month) => (
        <section>
          <h3 class="calendar__month">{month.label}</h3>
          {month.days.map((day) => (
            <div>
              <h4 class="calendar__day">{day.label}</h4>
              <ul class="stack-list">
                {day.events.map((event) => {
                  const when = eventWhenLabel(event);
                  const place = placeLabel(event);
                  return (
                    <li data-country={event.countryCode?.toLowerCase() ?? ""}>
                      {event.imageUrl ? (
                        <img
                          class="stack-list__thumb"
                          src={event.imageUrl}
                          alt=""
                          width="64"
                          height="64"
                          loading="lazy"
                        />
                      ) : (
                        <div class="stack-list__thumb" aria-hidden="true" />
                      )}
                      <div>
                        <p class="stack-list__title">
                          <a href={aboutEventPath(event.slug)}>{event.title}</a>
                        </p>
                        {(when || place) && (
                          <p class="stack-list__meta">
                            {when}
                            {when && place && " · "}
                            {place && (
                              <>
                                <CountryFlag code={event.countryCode} />
                                {place}
                              </>
                            )}
                          </p>
                        )}
                      </div>
                      <a class="chip" href={aboutEventPath(event.slug)}>
                        Details
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </section>
      ))}
    </div>
  )
}
