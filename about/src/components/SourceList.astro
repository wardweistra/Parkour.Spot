---
import StackListThumb from "./StackListThumb.astro";
import type {CommunitySource} from "../lib/types";
import {countNoun} from "../lib/citation";
import {instagramUrl} from "../lib/urls";

interface Props {
  sources: CommunitySource[];
  countKey?: "spotCount" | "eventCount";
  countNounBase?: string;
}

const {
  sources,
  countKey,
  countNounBase = "spot",
} = Astro.props;

function countLabel(source: CommunitySource): string | null {
  if (!countKey) return null;
  const n = Number(source[countKey]);
  if (!Number.isFinite(n) || n <= 0) return null;
  return countNoun(n, countNounBase);
}
---

{
  sources.length === 0 ? (
    <p class="empty">Source list is updating. Check back after the next refresh.</p>
  ) : (
    <ul class="stack-list source-list">
      {sources.map((source) => {
        const count = countLabel(source);
        const ig = source.instagramHandle;
        const href = source.publicUrl;
        const logoUrl = source.logoUrl?.trim() || null;
        const hasActions = Boolean(href || ig);
        return (
          <li class="stack-list__card source-list__row">
            <StackListThumb
              src={logoUrl}
              size={64}
              fit="contain"
              variant="source"
              alt={`${source.name} logo`}
            />
            <div class="source-list__body">
              <h3 class="stack-list__title">{source.name}</h3>
              {source.description && (
                <p class="stack-list__place">{source.description}</p>
              )}
              {count && (
                <p class="stack-list__meta stack-list__meta--quiet">{count}</p>
              )}
              {hasActions && (
                <p class="source-list__actions">
                  {ig && (
                    <a
                      class="source-list__action"
                      href={instagramUrl(ig)}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      @{ig}
                    </a>
                  )}
                  {href && (
                    <a
                      class="source-list__action"
                      href={href}
                      rel="noopener noreferrer"
                      target="_blank"
                    >
                      Public page
                    </a>
                  )}
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  )
}
