---
import "../styles/global.css";
import {DEFAULT_OG_IMAGE, GA_MEASUREMENT_ID, SITE_NAME} from "../lib/brand";
import {APP_DEFINITION, formatUpdatedAt} from "../lib/citation";
import {loadAboutIndex, useFixtures} from "../lib/snapshots";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | null;
  noIndex?: boolean;
  /** Absolute URL or site path. Falls back to the default share image. */
  image?: string | null;
  imageAlt?: string;
}

const {
  title,
  description = APP_DEFINITION,
  canonicalPath = "/",
  jsonLd = null,
  noIndex = false,
  image = null,
  imageAlt,
} = Astro.props;

const usesDefaultImage = !image;
const ogImage = new URL(image || DEFAULT_OG_IMAGE.path, Astro.site).toString();
const ogImageAlt = usesDefaultImage
  ? DEFAULT_OG_IMAGE.alt
  : imageAlt || title;

const aboutIndex = await loadAboutIndex();
const updatedLabel = formatUpdatedAt(aboutIndex.generatedAt);
const canonical = new URL(canonicalPath, Astro.site).toString();
const pageTitle =
  title.includes(SITE_NAME)
    ? title
    : `${title} · ${SITE_NAME}`;
const analyticsEnabled = import.meta.env.PROD && !useFixtures();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      analyticsEnabled && (
        <>
          <script
            is:inline
            define:vars={{gaId: GA_MEASUREMENT_ID}}
          >
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag("consent", "default", {
              ad_storage: "denied",
              analytics_storage: "granted",
              functionality_storage: "granted",
              personalization_storage: "denied",
              security_storage: "granted",
            });
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
        </>
      )
    }
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      usesDefaultImage && (
        <>
          <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE.width)} />
          <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE.height)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="site-header__brand" href="/">
            <img src="/logo-square.svg" alt="" width="36" height="36" />
            <span>{SITE_NAME}</span>
          </a>
          <nav class="site-nav" aria-label="Primary">
            <a
              href="/"
              aria-current={canonicalPath === "/" ? "page" : undefined}
            >
              About
            </a>
            <a
              href="/how-it-works"
              aria-current={canonicalPath === "/how-it-works" ? "page" : undefined}
            >
              How it works
            </a>
            <a
              href="/events"
              aria-current={canonicalPath.startsWith("/events") ? "page" : undefined}
            >
              Events
            </a>
          </nav>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>
            By and for the parkour community ·
            <a href="/how-it-works">How it works</a>
            ·
            <a href="https://parkour.spot">Open the map</a>
          </p>
          <p class="muted">
            about.parkour.spot{
              updatedLabel && (
                <>
                  {" "}
                  · Updated {updatedLabel}
                </>
              )
            }
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
