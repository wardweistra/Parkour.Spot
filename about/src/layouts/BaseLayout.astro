---
import "../styles/global.css";
import {SITE_NAME} from "../lib/brand";
import {APP_DEFINITION} from "../lib/citation";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | null;
  noIndex?: boolean;
}

const {
  title,
  description = APP_DEFINITION,
  canonicalPath = "/",
  jsonLd = null,
  noIndex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site).toString();
const pageTitle =
  title.includes(SITE_NAME) || title.includes("ParkourSpot")
    ? title
    : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_NAME} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap"
      rel="stylesheet"
    />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="site-header__brand" href="/">
            <img src="/logo-square.svg" alt="" width="36" height="36" />
            <span>{SITE_NAME}</span>
          </a>
          <nav class="site-nav" aria-label="Primary">
            <a
              href="/"
              aria-current={canonicalPath === "/" ? "page" : undefined}
            >
              About
            </a>
            <a
              href="/how-it-works"
              aria-current={canonicalPath === "/how-it-works" ? "page" : undefined}
            >
              How it works
            </a>
            <a
              href="/events"
              aria-current={canonicalPath.startsWith("/events") ? "page" : undefined}
            >
              Events
            </a>
          </nav>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">
          <p>
            By and for the parkour community ·
            <a href="/how-it-works">How it works</a>
            ·
            <a href="https://parkour.spot">Open the map</a>
          </p>
          <p class="muted">about.parkour.spot</p>
        </div>
      </footer>
    </div>
  </body>
</html>
