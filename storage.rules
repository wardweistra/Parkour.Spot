rules_version = '2';
service firebase.storage {
  // Align with Firestore `requestingUserIsAdmin`: custom claim `admin` OR users doc flag.
  function requestingUserIsAdmin() {
    return request.auth != null && (
      request.auth.token.admin == true ||
      (
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
      )
    );
  }

  match /b/{bucket}/o {
    // Spots images - anyone can read, authenticated users can upload
    match /spots/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Photo suggestions - anyone can read (for moderation).
    // Authenticated users can upload; guests can upload small images only (paired with email on the spot report).
    match /suggestions/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        || (request.resource.size > 0
            && request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null; // Allow deletion for cleanup/rejection
    }
    
    // Rejected photos - anyone can read (for moderation), authenticated users can move/delete
    match /rejected/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
      allow delete: if request.auth != null; // Allow deletion for cleanup
    }
    
    // User profile pictures - users can only manage their own
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // General media - anyone can read, authenticated users can upload
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Event images - public read, admin write (matches Firestore events collection)
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if requestingUserIsAdmin();
    }
    
    // Jumpflix thumbnails - public read, only Cloud Functions write
    match /jumpflix/thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // URBN migration files - authenticated users can read
    match /urbn/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only admins can upload via Firebase Console or CLI
    }
  }
}
