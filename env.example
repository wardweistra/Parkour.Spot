# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_APP_ID_WEB=your_app_id_here
FIREBASE_APP_ID_ANDROID=your_android_app_id_here
FIREBASE_APP_ID_IOS=your_ios_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_AUTH_DOMAIN=parkour.spot
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MEASUREMENT_ID=your_measurement_id_here
FIREBASE_WEB_PUSH_VAPID_KEY=your_web_push_vapid_key_here

# Android Maps SDK (separate from web JS key). Put in android/local.properties:
#   GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_key
# Or export as env var when building. Restrict to package parkour.spot + SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your_android_maps_api_key_here
