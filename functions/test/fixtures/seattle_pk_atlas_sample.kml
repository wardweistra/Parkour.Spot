					<altitude>61.1157592243266</altitude>
					<heading>338.6714262915402</heading>
					<tilt>88.41517000108806</tilt>
					<roll>0</roll>
					<gx:fovy>59.9999999996306</gx:fovy>
					<altitudeMode>absolute</altitudeMode>
				</Camera>
