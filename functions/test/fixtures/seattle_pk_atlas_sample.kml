			<Folder id="0180E92E6D24F0E983FB">
				<name>Kamiak High School</name>
				<LookAt>
					<longitude>-122.3019996195682</longitude>
					<latitude>47.90085242015724</latitude>
					<altitude>161.3257269504828</altitude>
