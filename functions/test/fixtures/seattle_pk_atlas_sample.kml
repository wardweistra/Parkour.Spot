				<Point>
					<coordinates>-122.3083017200918,47.6587871777368,59.12000197392014</coordinates>
				</Point>
			</Placemark>
			<Placemark id="03E9F5E65024F0789FA6">
				<name>Willow Hall</name>
				<gx:mid>/g/11gjwfdz21</gx:mid>
				<gx:fid>0x54901508a11b4d0d:0xf1cf927eaf7c9dcf</gx:fid>
