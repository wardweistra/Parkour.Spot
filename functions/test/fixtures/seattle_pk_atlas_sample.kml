				</Camera>
				<styleUrl>#__managed_style_0E9E5BFEFF41CCEEBB8B</styleUrl>
				<Point>
					<coordinates>-122.3107803408471,47.65918092562428,62.25130756778189</coordinates>
				</Point>
			</Placemark>
			<Placemark id="07CF360A5221FBE3E4F3">
				<name>PACCAR</name>
				<description><![CDATA[<div>Great spot with rails, concrete to grass drops, little concrete benches, and more.. <br></div><div>Current meeting spot for PKV Flips and Freerunning class.<br></div>]]></description>
				<Camera>
					<gx:ViewerOptions>
						<gx:option name="streetview"></gx:option>
						<gx:streetViewPanoId>Gb37xI68zmpgo9uDVyPobA</gx:streetViewPanoId>
