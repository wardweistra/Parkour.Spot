	<Folder id="01BD7CA5E721FBB80206">
		<name>Spots</name>
		<styleUrl>#__managed_style_1B90555AB041CCEEBB8F</styleUrl>
		<Folder id="022F59F2C024EA923BAD">
			<name>University of Washington</name>
			<description><![CDATA[<div>Possibly the largest concentration of well known spots in Seattle. There are many more than are documented in this Google Earth collection. <br></div>]]></description>
			<LookAt>
				<longitude>-122.306537716221</longitude>
				<latitude>47.65522732577291</latitude>
				<altitude>46.11648731880099</altitude>
				<heading>13.35440355783677</heading>
				<tilt>71.42628395488588</tilt>
				<gx:fovy>35</gx:fovy>
				<range>1007.702778218809</range>
				<altitudeMode>absolute</altitudeMode>
			</LookAt>
			<styleUrl>#__managed_style_030E64063A41CCEEBB8C</styleUrl>
			<Placemark id="04CFCA148D24F08BA4A8">
				<name>Benjamin Hall Interdisciplinary Research Building(R&amp;T Bldg) (RTB)</name>
				<gx:mid>/g/1hm3th2t2</gx:mid>
				<gx:fid>0x549014f12e93f66d:0x5a7ccddec4c79f00</gx:fid>
				<LookAt>
					<longitude>-122.3213534</longitude>
					<latitude>47.6552709</latitude>
					<altitude>0</altitude>
					<heading>0</heading>
					<tilt>0</tilt>
					<gx:fovy>35</gx:fovy>
					<range>708.2257637575086</range>
					<altitudeMode>relativeToGround</altitudeMode>
				</LookAt>
				<styleUrl>#__managed_style_511B0855F241CCEEBB8C</styleUrl>
				<Point>
					<altitudeMode>relativeToGround</altitudeMode>
					<coordinates>-122.3213534,47.6552709,0</coordinates>
				</Point>
			</Placemark>
			<Placemark id="0D41789D6B258070ECF9">
				<name>Condon Hall</name>
				<description><![CDATA[<div>Extremely brutalist architecture with plenty of concrete walls at interesting distances and angles. Building is pretty climbable, but might not have an easy route to the very top.&nbsp;</div>]]></description>
				<Camera>
					<gx:ViewerOptions>
						<gx:option name="streetview"></gx:option>
						<gx:streetViewPanoId>6ts7INpM9uKoTlxlLm7tyA</gx:streetViewPanoId>
					</gx:ViewerOptions>
					<longitude>-122.3156395492594</longitude>
					<latitude>47.65622817978673</latitude>
					<altitude>29.23017311096191</altitude>
					<heading>328.8802313339388</heading>
					<tilt>102.1545118545158</tilt>
					<roll>0</roll>
					<gx:fovy>59.99999999980925</gx:fovy>
					<altitudeMode>absolute</altitudeMode>
				</Camera>
				<styleUrl>#__managed_style_0E9E5BFEFF41CCEEBB8B</styleUrl>
				<Point>
					<coordinates>-122.3158413154874,47.65640254223222,28.1995540441159</coordinates>
				</Point>
			</Placemark>
			<Placemark id="043A15B49121FBEBF6EE">
				<name>Law Courtyard</name>
				<Camera>
					<gx:ViewerOptions>
						<gx:option name="streetview"></gx:option>
						<gx:streetViewPanoId>ynXLU2MDGqbqj0O--Kwe2A</gx:streetViewPanoId>
					</gx:ViewerOptions>
					<longitude>-122.310874878177</longitude>
